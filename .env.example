# AUTH_SECRET: Secret key used to sign HttpOnly admin session tokens (HMAC-SHA256)
AUTH_SECRET="lasanta-store-cartagena-hmac-secret-2026-prod"

# ADMIN_PIN: Optional server-side override for the Admin & POS PIN (default in DB: 1234)
ADMIN_PIN="1234"

# WEBHOOK_SECRET: Secret key for verifying incoming payment/shipping webhook signatures
WEBHOOK_SECRET="lasanta-webhook-hmac-secret-2026"

# APP_URL: Public URL of La Santa Store on Hostinger
APP_URL="https://lasanta.store"
