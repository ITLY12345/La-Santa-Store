# ============================================================================
# LA SANTA STORE — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ============================================================================

# URL pública oficial de la tienda en Hostinger
APP_URL="https://lasantastore.enigmaproducciones.com"

# Clave maestra criptográfica (mínimo 32 caracteres aleatorios) para firmar sesiones HttpOnly (HMAC-SHA256)
AUTH_SECRET="REEMPLAZAR_CON_SECRETO_CRIPTOGRAFICO_HEX_64_CARACTERES"

# PIN de acceso para Consola Administrativa y Terminal POS (por defecto: 1234)
ADMIN_PIN="1234"

# Clave secreta para verificar firmas HMAC-SHA256 en Webhooks de pasarelas de pago / logística
WEBHOOK_SECRET="REEMPLAZAR_CON_SECRETO_WEBHOOK_HEX_64_CARACTERES"
